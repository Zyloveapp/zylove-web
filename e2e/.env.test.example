# Test-only secrets for the e2e suite (copy to .env.test, which is gitignored).
# None of these are production values.

# Twilio webhook signing token for the emulator (17-sms-consent signs with it).
TWILIO_AUTH_TOKEN=e2e-twilio-token

# HMAC key for hashed device/IP signals (T&S Phase 1). Any random string for tests.
TRUST_HASH_KEY=e2e-trust-hash-key
