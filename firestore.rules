rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function isMatchParticipant(matchId) {
      // Reads the parent match doc's users[] array — robust to UIDs that
      // contain underscores (which would break matchId.split('_') heuristic).
      // Cost: 1 billed read per message-subcollection rule evaluation.
      // A Play match also needs the viewer's Play access (Stage 2).
      return exists(/databases/$(database)/documents/matches/$(matchId))
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.get('users', [])
          && (get(/databases/$(database)/documents/matches/$(matchId)).data.get('mode', 'spark') != 'play'
              || viewerHasPlay());
    }

    // Blocks (Stage A): a blocked match is read-only for the person who
    // blocked (evidence for a report) and closed to the person blocked.
    function matchReadable(m) {
      return m.get('isBlocked', false) != true || m.get('blockedBy', '') == request.auth.uid;
    }
    // New messages and match updates only while the match is live: not
    // blocked, not unmatched.
    function matchLive(m) {
      return m.get('isBlocked', false) != true && m.get('unmatchedAt', null) == null;
    }
    function matchDoc(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // ─── Play access (Stage 2, F-004) ───────────────────────────────────────
    // Play data is sealed: another person's Play profile, Play scores, Play
    // matches and chats and Play likes take Play access. The server keeps
    // userInternal/{uid}.playAccess (+ playAccessUntil when a trial grants
    // it; see functions/src/playAccess.ts). Bots (zbot-) always have it.
    function playFlagOn(uid) {
      let d = get(/databases/$(database)/documents/userInternal/$(uid)).data;
      return d.get('playAccess', false) == true
          && (d.get('playAccessUntil', null) == null || request.time < d.playAccessUntil);
    }
    function hasPlay(uid) {
      return uid.matches('^zbot-.*$') || playFlagOn(uid);
    }
    function viewerHasPlay() {
      return request.auth != null && hasPlay(request.auth.uid);
    }

    // ─── Plans (Stage C) ─────────────────────────────────────────────────────
    // userInternal/{uid}.entitlement = { tier, until } is decided server-side
    // (functions/src/entitlements.ts). A trial's tier ends at `until`, on the
    // second. Bots (zbot-) are Elite.
    function tierRank(uid) {
      let e = get(/databases/$(database)/documents/userInternal/$(uid)).data.get('entitlement', {});
      let live = e.get('until', null) == null || request.time < e.until;
      return uid.matches('^zbot-.*$') ? 2
           : !live ? 0
           : e.get('tier', 'free') == 'elite' ? 2
           : e.get('tier', 'free') == 'spark_plus' ? 1
           : 0;
    }
    function viewerHasSparkPlus() {
      return request.auth != null && exists(/databases/$(database)/documents/userInternal/$(request.auth.uid))
          && tierRank(request.auth.uid) >= 1;
    }
    function viewerHasElite() {
      return request.auth != null && exists(/databases/$(database)/documents/userInternal/$(request.auth.uid))
          && tierRank(request.auth.uid) >= 2;
    }

    // Account state (Stage 3): suspension is server-only, in
    // userInternal/{uid}.isSuspended; deleted profiles are flagged isDeleted
    // on the public doc. Bots and brand-new accounts may have no userInternal.
    function notSuspended(uid) {
      return !exists(/databases/$(database)/documents/userInternal/$(uid))
          || get(/databases/$(database)/documents/userInternal/$(uid)).data.get('isSuspended', false) != true;
    }
    // T&S Phase 4: the caller isn't suspended — enforced here as well as at
    // sign-in (onBeforeSignIn), so a session that's still valid, or a
    // blocking-function failure, can't write after a suspension. Accounts
    // suspended only for a pending deletion, and suspensions past their end
    // date, aren't refused (same as sign-in).
    function suspensionInactive(n) {
      return n.get('isSuspended', false) != true
          || n.get('suspendedForDeletion', false) == true
          || (n.get('suspendedUntil', null) != null && n.suspendedUntil <= request.time);
    }
    function callerActive() {
      return !exists(/databases/$(database)/documents/userInternal/$(request.auth.uid))
          || suspensionInactive(get(/databases/$(database)/documents/userInternal/$(request.auth.uid)).data);
    }
    function profileVisible(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('isDeleted', false) != true
          && notSuspended(uid);
    }

    // Blocks (Stage B, F-055): the person blocked can't read the blocker's
    // profile. The one who placed the block still can — their read-only
    // chat needs the other's public key. users/{uid}/blockedUsers/{viewer}
    // exists on both sides of a block, recording who placed it (blockedBy).
    function notBlockedFrom(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(request.auth.uid)).data.get('blockedBy', '') == request.auth.uid;
    }
    // A match between the viewer and uid exists (match ids are the sorted pair).
    function matchedWith(uid) {
      return exists(/databases/$(database)/documents/matches/$(uid < request.auth.uid ? uid + '_' + request.auth.uid : request.auth.uid + '_' + uid));
    }

    // ─── Private Play IDs (F-062) ────────────────────────────────────────────
    // In Play, people are known by an opaque Play ID, never the uid
    // (functions/src/playIds.ts). The mapping — playIds/{uid} and
    // playIdOwners/{playId} — is server-only (default deny below); these rules
    // read it to tell who the caller is in Play and whose a Play ID is, which
    // a client never sees. No rule here compares a client-supplied uid with a
    // Play ID's owner, so the rules can't be used to test the mapping either.
    function myPlayId() {
      return get(/databases/$(database)/documents/playIds/$(request.auth.uid)).data.playId;
    }
    function playOwner(playId) {
      return get(/databases/$(database)/documents/playIdOwners/$(playId)).data.uid;
    }
    // The viewer and playId have a live Play match (playPairs: sorted Play IDs).
    function playMatchedWith(playId) {
      let me = myPlayId();
      return exists(/databases/$(database)/documents/playPairs/$(playId < me ? playId + '_' + me : me + '_' + playId));
    }
    function playMatchDoc(matchId) {
      return get(/databases/$(database)/documents/playMatches/$(matchId)).data;
    }
    // One of the two people in a Play match, with Play access.
    function isPlayParticipant(matchId) {
      return exists(/databases/$(database)/documents/playMatches/$(matchId))
          && myPlayId() in playMatchDoc(matchId).get('players', [])
          && viewerHasPlay();
    }
    function playMatchReadable(m) {
      return m.get('isBlocked', false) != true || m.get('blockedBy', '') == myPlayId();
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // users/{uid} is the public profile: every signed-in user can read it
    // (Explore, profiles, chat), so it holds profile fields only. Everything
    // else lives where other users can't read it (functions/src/userData.ts):
    //   userInternal/{uid}          plan, payments, trust and safety, counters
    //                               (server-only: default deny below)
    //   userLocations/{uid}         snapped coordinates, market (server-only)
    //   users/{uid}/private/account owner reads; server writes
    //   users/{uid}/private/settings owner reads and writes (allow-listed keys)
    //   users/{uid}/private/identity owner; legal name once, birthday until locked
    // The client may never write any of those fields here (serverOnlyUserFields).

    function serverOnlyUserFields() {
      return [
        // Trust and safety, verification, admin
        'isSuspended', 'reportCount', 'reportTier1Count', 'reportTier2Count', 'reportTier3Count',
        'verificationStatus', 'sparkScore', 'zyloveScore', 'zylovScore', 'zyloveScoreTier', 'isAdmin',
        // Founder badge
        'isFounder', 'founderCohort', 'founderNumber', 'founderBadgeAssignedAt',
        // Plan and payments
        'subscriptionTier', 'subscriptionStatus', 'subscriptionSource', 'subscriptionGrantedAt', 'subscriptionUpdatedAt',
        'stripeCustomerId', 'stripeSubscriptionId',
        'trialStartedAt', 'trialEndsAt', 'trialExpired',
        // Names: legal name is private; the name-change timestamps are
        // server-only (updateDisplayName enforces the 30-day limit with them)
        'legalName', 'displayNameUpdatedAt', 'playDisplayNameUpdatedAt',
        // Private: phone, birthday, location, settings
        'phoneNumber', 'smsConsent', 'birthday',
        'locationLat', 'locationLng', 'locationUpdatedAt', 'geohash', '_location',
        'smsNotifications', 'smsNotificationsEnabled', 'smsQuietHours',
        'photoAnalysisConsent', 'aiPhotoScanningConsent', 'photoScanningConsent', 'photoScanningConsentAt',
        // Moderation and internal state
        'pendingPhotoURLs', 'photoRejectedAt', 'photoRejectionReason', 'hasPendingPhotos',
        'expoPushToken', 'bioGenerations', 'goDeeperGenerations', 'profileReviews',
        'lastSparkSmsAt', 'claimSMSSentAt', 'likesReceivedCount', 'lastActive',
        // Stage 2: Play profile fields (→ playProfile/data) and metadata that
        // reveals Play use (→ the owner-only private/profile)
        'playDisplayName', 'playDisplayNameUpdatedAt', 'playVisibility', 'spiceLevel', 'playInterestTags',
        'playNonNegotiables', 'playBio', 'playPromptAnswers', 'playGoDeeper', 'typePreferences', 'playBodyType',
        'playHeight', 'playBodyHair', 'playGrooming', 'playEnergy', 'playStyle', 'playPassExpiresAt', 'openToCrossover',
        'intent', 'onboardingPath', 'mode', 'intentionAnswers',
        // Stage 3: matching preferences (→ the owner-only private/matching;
        // Explore and scoring read them server-side), account state and
        // moderation notes (→ userInternal / private/account)
        'attractedTo', 'matchableAs', 'ageMin', 'ageMax', 'radiusMiles', 'drinkingHabit', 'showOrientation',
        'dealbreakers', 'seekingBodyTypes', 'seekingTraits', 'seekingHeightMinCm', 'seekingHeightMaxCm',
        'suspendedAt', 'suspendedUntil', 'suspendedBy', 'suspendSource', 'suspendReason', 'suspendedPendingReview',
        'bannedAt', 'bannedBy', 'deletionRequestedAt', 'deletionScheduledFor', 'deletionReason',
        'adminNotice', 'lastWarnedAt', 'lastThankedAt',
        // Stage A: server-decided state other code trusts — bot status
        // (reports refuse bots), deletion, founder status and badge, Explore order
        'isBot', 'isDeleted', 'deleted', 'deletedAt', 'previousUid', 'sortKey',
        'founderBadge', 'founderStatus', 'founderCity', 'founderCityId', 'founderRevokedAt', 'founderConvertedAt',
        'founderLastActiveAt', 'founderWarningSentAt', 'founderThreadMeta',
        // T&S Phase 1: account age comes from Firebase Auth, written by the
        // server ("Member since"; createdAt is the client's and can't be trusted)
        'memberSince', 'accountCreatedAt',
        // T&S Phase 2: the reply band ("Usually replies") and, for a new
        // account's first 48 hours, when that ends (links note)
        'replyBand', 'newUntil',
        // F-066: the identity lock is set by the server on the first gender
        // write (identityGuardOnUser)
        'identityLockedAt'
      ];
    }

    // F-066: 18+. A public age written by the client must be an adult's, and
    // a birthday (private/identity, "YYYY-MM-DD") an adult's as of now — a
    // 29 February birthday counts from 1 March. The server also suspends
    // anyone under 18 who got past this (identityGuard.ts).
    function adultAge(d) {
      return d.get('age', null) == null || (d.age is int && d.age >= 18 && d.age <= 120);
    }
    function adultBirthday(b) {
      return (int(b[5:7]) == 2 && int(b[8:10]) == 29
                ? timestamp.date(int(b[0:4]) + 18, 3, 1)
                : timestamp.date(int(b[0:4]) + 18, int(b[5:7]), int(b[8:10]))) <= request.time;
    }

    // Published photos (photoURLs) are added only by Cloud Functions after
    // moderation (onPhotoUpload, reviewPendingPhoto): clients may remove or
    // reorder them, never add (getPhotoUrls hands a photo out to others only
    // while it's published). Play photos never sit on the root doc (Stage 2).
    function photosOnlyShrink(before, after) {
      return after.get('photoURLs', []).toSet()
                  .difference(before.get('photoURLs', []).toSet()).size() == 0;
    }

    // Profiles are read one at a time (a profile, a chat partner); nobody
    // lists the collection — Explore is server-side (getExploreDeck, Stage 3),
    // so the user base can't be paged through. Suspended and deleted
    // profiles are unreadable except by their owner.
    match /users/{uid} {
      allow get: if isSignedIn()
                 && (resource == null
                     || isUser(uid)
                     || (resource.data.get('isDeleted', false) != true && notSuspended(uid) && notBlockedFrom(uid)));
      allow list: if false;
      allow create: if callerActive() && isUser(uid) && isSignedIn()
                    && !request.resource.data.keys().hasAny(serverOnlyUserFields())
                    && request.resource.data.get('photoURLs', []).size() == 0
                    && adultAge(request.resource.data);
      // Identity-lock fields (age, genderIdentity, matchableAs,
      // identityLockedAt): blocked AFTER identityLockedAt is set. First
      // write (when field is still null) is permitted — that's the slide-2
      // confirm or the retroactive ensureIdentityLock write. Age then
      // follows the private birthday server-side (refreshAges).
      // Public names (displayName, playDisplayName): the first one is set
      // directly by onboarding; after that only updateDisplayName changes them.
      allow update: if callerActive() && isUser(uid) && isSignedIn()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields())
                    && photosOnlyShrink(resource.data, request.resource.data)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['age']) || adultAge(request.resource.data))
                    && (resource.data.get('identityLockedAt', null) == null
                        || !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['age', 'genderIdentity', 'matchableAs', 'identityLockedAt']))
                    && (resource.data.get('displayName', null) == null
                        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']));
      // Never deleted by the client: recreating it would reset the identity
      // lock (Stage A). Account deletion is server-side.
      allow delete: if false;

      // Plan mirror, SMS consent (with the verified phone), Spark photos in
      // review and the saved-location summary. Written by Cloud Functions;
      // the owner may only empty their Spark photo-review queue.
      match /private/account {
        allow read: if isSignedIn() && isUser(uid);
        // The owner may empty their Spark photo-review queue, or mark the
        // moderation team's notice as seen (adminNotice.seenAt, F-040).
        allow update: if isSignedIn() && isUser(uid)
                      && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingPhotoURLs'])
                           && request.resource.data.pendingPhotoURLs is list
                           && request.resource.data.pendingPhotoURLs.size() == 0)
                          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminNotice'])
                              && request.resource.data.adminNotice.diff(resource.data.adminNotice).affectedKeys().hasOnly(['seenAt'])));
        allow create, delete: if false;
      }

      // Matching preferences (Stage 3, F-013): owner only; Explore and
      // scoring read them server-side. These keys only.
      function matchingKeys() {
        return ['attractedTo', 'matchableAs', 'ageMin', 'ageMax', 'radiusMiles', 'drinkingHabit', 'showOrientation',
                'dealbreakers', 'seekingBodyTypes', 'seekingTraits', 'seekingHeightMinCm', 'seekingHeightMaxCm'];
      }
      function validMatching(d) {
        return d.keys().hasOnly(matchingKeys())
            && (!('attractedTo' in d) || d.attractedTo is list)
            && (!('matchableAs' in d) || d.matchableAs is list)
            && (!('ageMin' in d) || d.ageMin is int)
            && (!('ageMax' in d) || d.ageMax is int)
            // Stage C: the viewer's own distance, 1–100 miles (no "no limit").
            && (!('radiusMiles' in d) || (d.radiusMiles is number && d.radiusMiles >= 1 && d.radiusMiles <= 100));
      }
      // matchableAs (how off-map identities are matched) stays identity-locked,
      // as it was on the public doc.
      match /private/matching {
        allow read: if isSignedIn() && isUser(uid);
        allow create: if callerActive() && isSignedIn() && isUser(uid) && validMatching(request.resource.data)
                      && (!('matchableAs' in request.resource.data) || identityUnlocked());
        allow update: if callerActive() && isSignedIn() && isUser(uid) && validMatching(request.resource.data)
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['matchableAs']) || identityUnlocked());
        allow delete: if false;
      }

      // The owner's preferences: texts and AI photo coaching. These keys only.
      function settingsKeys() {
        return ['smsNotificationsEnabled', 'smsNotifications', 'smsQuietHours', 'photoAnalysisConsent', 'safetyTipsSeenAt'];
      }
      function validSettings(d) {
        return d.keys().hasOnly(settingsKeys())
            && (!('smsNotificationsEnabled' in d) || d.smsNotificationsEnabled is map || d.smsNotificationsEnabled is bool)
            && (!('smsNotifications' in d) || d.smsNotifications is map)
            && (!('smsQuietHours' in d) || d.smsQuietHours is map)
            && (!('photoAnalysisConsent' in d) || d.photoAnalysisConsent is map)
            // T&S Phase 2: when the first-match safety card was seen (ms).
            && (!('safetyTipsSeenAt' in d) || d.safetyTipsSeenAt is int);
      }
      match /private/settings {
        allow read: if isSignedIn() && isUser(uid);
        allow create, update: if isSignedIn() && isUser(uid) && validSettings(request.resource.data);
        allow delete: if false;
      }

      // Legal name (set once, never changed) and birthday (changeable until
      // users/{uid}.identityLockedAt is set; a profile that doesn't exist yet
      // is unlocked — onboarding writes both in one batch).
      function identityUnlocked() {
        return !exists(/databases/$(database)/documents/users/$(uid))
            || get(/databases/$(database)/documents/users/$(uid)).data.get('identityLockedAt', null) == null;
      }
      function validIdentity(d) {
        return d.keys().hasOnly(['legalName', 'legalNameSetAt', 'birthday'])
            && (!('legalName' in d) || (d.legalName is string && d.legalName.size() <= 100))
            && (!('birthday' in d) || (d.birthday is string && d.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && adultBirthday(d.birthday)));
      }
      // Profile metadata that would reveal Play use (Stage 2): which modes the
      // owner uses, the current mode, their intentions. Owner only.
      function validPrivateProfile(d) {
        return d.keys().hasOnly(['intent', 'onboardingPath', 'mode', 'intentionAnswers'])
            && (!('intent' in d) || d.intent in ['spark', 'play', 'open'])
            && (!('onboardingPath' in d) || d.onboardingPath in ['spark', 'play', 'both'])
            && (!('mode' in d) || d.mode in ['spark', 'play'])
            && (!('intentionAnswers' in d) || (d.intentionAnswers is list && d.intentionAnswers.size() <= 20));
      }
      match /private/profile {
        allow read: if isSignedIn() && isUser(uid);
        allow create, update: if callerActive() && isSignedIn() && isUser(uid) && validPrivateProfile(request.resource.data);
        allow delete: if false;
      }

      match /private/identity {
        allow read: if isSignedIn() && isUser(uid);
        allow create: if isSignedIn() && isUser(uid)
                      && validIdentity(request.resource.data)
                      && (!('birthday' in request.resource.data) || identityUnlocked());
        allow update: if isSignedIn() && isUser(uid)
                      && validIdentity(request.resource.data)
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['legalName', 'legalNameSetAt'])
                          || !('legalName' in resource.data))
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['birthday'])
                          || identityUnlocked());
        allow delete: if false;
      }

      // Spark profile subcollection
      match /sparkProfile/{doc} {
        allow read: if isSignedIn()
                    && (isUser(uid) || (profileVisible(uid) && notBlockedFrom(uid)));
        allow write: if callerActive() && isUser(uid) && isSignedIn();
      }

      // Play profile subcollection (Stage 2: the only home of Play profile
      // data). The owner always reads their own; anyone else needs Play
      // access, and so does the owner for others to see it (a lapsed or
      // unfinished Play profile is hidden — kept, and back when access is).
      // Photos as on the root doc: clients only remove or reorder them;
      // pending photos live in private/account (F-031). Server-only:
      // playVisibility (setVisibility), playDisplayNameUpdatedAt; the Play
      // name is set once here, then changed only by updateDisplayName.
      function playServerFields() {
        return ['pendingPhotoURLs', 'playVisibility', 'playDisplayNameUpdatedAt'];
      }
      // F-062: owner-only — others see the server-kept copy, playProfiles/
      // {playId}, which carries no uid.
      match /playProfile/{doc} {
        allow read: if isSignedIn() && isUser(uid);
        allow create: if callerActive() && isUser(uid) && isSignedIn()
                      && request.resource.data.get('photoURLs', []).size() == 0
                      && !request.resource.data.keys().hasAny(playServerFields());
        allow update: if callerActive() && isUser(uid) && isSignedIn()
                      && photosOnlyShrink(resource.data, request.resource.data)
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(playServerFields())
                      && (resource.data.get('playDisplayName', null) == null
                          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['playDisplayName']));
        allow delete: if isUser(uid) && isSignedIn();
      }

      // Visibility settings — own only
      // settings/playPin held the Play PIN's hash; it's server-only now
      // (Stage B: checked by checkPlayPin, upgraded into playPins/{uid}).
      match /settings/{doc} {
        allow read, write: if isUser(uid) && isSignedIn() && doc != 'playPin';
      }

      // Saved "How's my profile?" reviews — written by zylove-web's
      // reviewProfile / reviewPlayProfile. Owner reads, server writes.
      match /profileReviews/{mode}/reviews/{reviewId} {
        allow read: if isUser(uid) && isSignedIn();
        allow write: if false;
      }

      // Seeking preferences — own only
      match /seekingPreferences/{doc} {
        allow read, write: if isUser(uid) && isSignedIn();
      }

      // Like queue — who liked you. Written only by Cloud Functions (onLike,
      // bots): likeBack treats an entry as a real like, so a client may never
      // create one (Stage A). Play likes (mode 'play') carry the liker's Play
      // profile: the owner needs Play access to read them (queries filter on mode).
      match /likeQueue/{doc} {
        // Stage C: the list (who, not how many) is Spark+; Free gets the
        // count from getLikeCount.
        // A bot's like is visible on every plan (no paid feature involves a bot).
        // F-062: Play likes are keyed by the liker's Play ID; a curated one
        // says so (curated).
        allow read: if isUser(uid) && isSignedIn()
                    && (viewerHasSparkPlus() || doc.matches('^zbot-.*$') || resource.data.get('curated', false) == true)
                    && (resource.data.get('mode', 'spark') != 'play' || viewerHasPlay());
        // The owner may dismiss an entry (and nothing else) or delete it.
        allow update: if callerActive() && isSignedIn() && isUser(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed', 'dismissedAt']);
        allow delete: if callerActive() && isSignedIn() && isUser(uid);
        allow create: if false;
      }

      // Blocked users list — CF-only writes via blockUser Callable. F-062:
      // server-only (it's keyed by uid, and a block placed from Play would
      // show the blocker the other person's uid). The app lists blocks with
      // getBlockedUsers; these rules still check it (notBlockedFrom).
      match /blockedUsers/{targetUid} {
        allow read, write: if false;
      }

      // Per-user match index — tracks lastReadAt / unread counts per match.
      // Self-only read/write.
      match /matches/{matchId} {
        allow read, write: if isUser(uid) && isSignedIn();
      }

      // Free-tier state — weekly Spark, boost, etc. Self-only.
      match /freeTierState/{doc} {
        allow read, write: if isUser(uid) && isSignedIn();
      }

      // Profile view log — self reads own views. Any signed-in user writes
      // a view entry (mirrors likeQueue / blockedUsers cross-user pattern —
      // onProfileView Cloud Function also writes these via admin SDK).
      match /profileViews/{viewerUid} {
        allow read: if isUser(uid) && isSignedIn();
        allow write: if false; // CF-only via onProfileView Callable
      }

      // Legal audit trail — terms acceptance, written only by zylove-web's
      // recordTermsAcceptance (server time, IP, user agent, document
      // versions). Owner-read; no client writes, so a record can't be forged
      // or wiped.
      match /legalAcceptance/{docId} {
        allow read:  if isUser(uid) && isSignedIn();
        allow write: if false;
      }

      // Zylove score — owner read only; CF-only writes
      // The Zylove Score page is Elite (Stage C).
      match /zyloveScore/{doc} {
        allow read: if isUser(uid) && isSignedIn() && viewerHasElite();
        allow write: if false;
      }
    }

    // ─── Pairs ──────────────────────────────────────────────────────────────
    // Server-only (F-065). Scores reach the app through onTap and the other
    // callables, and Spark reveals are recorded by recordSparkReveal. A pair's
    // id is the uid pair, so reading (or even updating) one told a participant
    // whether it existed — which, after a Play tap, said who a Play ID was —
    // and showed the other person's reveal fields to anyone. Play pair state
    // lives in playPairData, keyed by Play IDs (default deny).
    match /pairs/{pairId}/{document=**} {
      allow read, write: if false;
    }
    match /pairs/{pairId} {
      allow read, write: if false;
    }

    // ─── Matches ────────────────────────────────────────────────────────────
    // Only the two participants can read or write a match doc

    match /matches/{matchId} {
      // Read/update/delete check the EXISTING doc's users[] — validator-
      // compatible with query.where('users', 'array-contains', uid).
      // Create checks the NEW doc's users[] since resource is null on create.
      // A Play match (mode 'play') and everything in it needs Play access
      // (Stage 2): while it's lapsed the match is hidden — kept, and back
      // when access is. Matches are created only by Cloud Functions.
      allow read: if isSignedIn()
                  && resource.data.get('isSuspended', false) != true
                  && request.auth.uid in resource.data.get('users', [])
                  && (resource.data.get('mode', 'spark') != 'play' || viewerHasPlay())
                  && matchReadable(resource.data);
      allow create: if false;
      // Participants keep the chat's own bookkeeping up to date, nothing
      // else (Stage A): who's in it, its mode, block/unmatch state, bot
      // status, generation, snapshots and the SMS clocks are server-only —
      // callables and triggers trust them. Photo consent can only become
      // 'accepted' through the acceptPhotoConsent Cloud Function, which
      // checks the other person really asked; clients may request, decline
      // and pause.
      allow update: if callerActive() && isSignedIn()
                    && request.auth.uid in resource.data.get('users', [])
                    && (resource.data.get('mode', 'spark') != 'play' || viewerHasPlay())
                    && matchLive(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'lastMessagePreview', 'lastMessageAt', 'lastSenderId', 'hasUnread',
                         'safetyCardShown', 'safetyCardShownAt', 'photoConsent',
                         'vibeCheckState_' + request.auth.uid])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessagePreview'])
                        || request.resource.data.lastMessagePreview == null
                        || (request.resource.data.lastMessagePreview is string && request.resource.data.lastMessagePreview.size() <= 40))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
                        || request.resource.data.lastSenderId == request.auth.uid)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoConsent'])
                        || request.resource.data.get('photoConsent', {}).get('status', '') != 'accepted'
                        || resource.data.get('photoConsent', {}).get('status', '') == 'accepted');
      // Unmatching goes through unmatchConnection; a client can't delete the
      // chat (and the other person's copy of it).
      allow delete: if false;

      // Messages — both participants can read/write.
      // Read rule additionally enforces self-destruct expiry: after expiresAt
      // passes, only the sender keeps read access (so their UI can render the
      // "📸 Photo destructed" terminal state from destructedAt). The recipient
      // gets denied — defense in depth alongside the sweep nulling ciphertext.
      // The shapes the app sends (Stage A): a text, an encrypted photo whose
      // ciphertext is in this match's chat-photos folder under the sender's
      // name (sweepChatPhotos deletes it with admin rights), or a photo-
      // consent notice. Server time only; nothing else.
      // T&S Phase 1: plaintext ('stub' nonces) only to a curated profile —
      // between two people every text is end-to-end encrypted. `fh` is the
      // optional on-device hash of a first message (duplicate-opener check;
      // the server drops it from the message once recorded).
      function partnerIsBot(m) {
        return m.get('isBot', false) == true
            || (m.get('users', []).size() == 2
                && ((m.users[0] != request.auth.uid && m.users[0].matches('^(zbot|seed)-.*'))
                    || (m.users[1] != request.auth.uid && m.users[1].matches('^(zbot|seed)-.*'))));
      }
      // T&S Phase 4: franking — the commitment `fc`, the per-message key `fk`
      // (encrypted to the partner, nonce `fkn`), a client message id `cid` and
      // the sender's sequence number `seq`. Optional (older apps don't send
      // them); when present, all of them, well-formed.
      function validFrank(d) {
        return !d.keys().hasAny(['fc', 'fk', 'fkn', 'cid', 'seq'])
            || (d.keys().hasAll(['fc', 'fk', 'fkn', 'cid', 'seq'])
                && d.fc is string && d.fc.matches('^[a-f0-9]{64}$')
                && d.fk is string && d.fk.size() <= 200
                && d.fkn is string && d.fkn.size() <= 64
                && d.cid is string && d.cid.matches('^[A-Za-z0-9_-]{8,64}$')
                && d.seq is int && d.seq >= 1 && d.seq <= 1000000);
      }
      function validTextMessage(d, m) {
        return d.keys().hasOnly(['ciphertext', 'nonce', 'senderId', 'sentAt', 'status', 'messageType', 'fh', 'fc', 'fk', 'fkn', 'cid', 'seq'])
            && validFrank(d)
            && d.messageType == 'text'
            && d.ciphertext is string && d.ciphertext.size() <= 20000
            && d.nonce is string && d.nonce != 'system' && d.nonce.size() <= 64
            && (!(d.nonce in ['stub', 'stub-nonce']) || partnerIsBot(m))
            && (!('fh' in d) || (d.fh is string && d.fh.matches('^[a-f0-9]{64}$')));
      }
      function validPhotoMessage(d) {
        return d.keys().hasOnly(['senderId', 'messageType', 'encrypted', 'storageRef', 'photoNonce',
                                 'encryptedKeyForSender', 'encryptedKeyForRecipient', 'keyNonceForSender',
                                 'keyNonceForRecipient', 'timerSeconds', 'firstViewedAt', 'photoExpiresAt',
                                 'destructedAt', 'sentAt', 'status', 'fc', 'fk', 'fkn', 'cid', 'seq'])
            && validFrank(d)
            && d.messageType == 'photo'
            // Sending photos in chat is Spark+ (Stage C); receiving isn't.
            && viewerHasSparkPlus()
            // T&S Phase 1: only once the other person accepted photo sharing.
            && matchDoc(matchId).get('photoConsent', {}).get('status', '') == 'accepted'
            && d.storageRef is string
            && d.storageRef.matches('^chat-photos/' + matchId + '/' + request.auth.uid + '_[A-Za-z0-9._-]+$')
            && d.get('timerSeconds', 0) is int && d.get('timerSeconds', 0) >= 0 && d.get('timerSeconds', 0) <= 86400
            && d.get('firstViewedAt', null) == null && d.get('photoExpiresAt', null) == null && d.get('destructedAt', null) == null;
      }
      function validConsentMessage(d) {
        return d.keys().hasOnly(['senderId', 'messageType', 'ciphertext', 'nonce', 'sentAt', 'status'])
            && d.messageType == 'consent_request'
            && d.nonce == 'system'
            && d.ciphertext in ['photo_consent_request', 'photo_consent_declined', 'photo_consent_paused'];
      }
      // T&S Phase 3: a contact card — end-to-end encrypted (never a stub or
      // system nonce), never to a curated profile, and only while the
      // exchange is accepted (which only the respondContactExchange callable
      // sets, after requestContactExchange checked both people sent 3+
      // messages): from the person who asked, or from the other person if
      // they chose to share back. Requests, answers and revokes are
      // server-written notices.
      function validContactCard(d, m) {
        return d.keys().hasOnly(['ciphertext', 'nonce', 'senderId', 'sentAt', 'status', 'messageType'])
            && d.messageType == 'contact_card'
            && d.ciphertext is string && d.ciphertext.size() > 0 && d.ciphertext.size() <= 4000
            && d.nonce is string && d.nonce.size() <= 64 && !(d.nonce in ['stub', 'stub-nonce', 'system', 'revoked'])
            && !partnerIsBot(m)
            && m.get('contactExchange', {}).get('status', '') == 'accepted'
            && (m.contactExchange.get('requestedBy', '') == request.auth.uid
                || m.contactExchange.get('shareBack', false) == true);
      }
      match /messages/{messageId} {
        // Self-destructed photos: after photoExpiresAt only the sender keeps
        // read access (to show the "destructed" state); the sweep removes
        // the ciphertext and keys too.
        allow read: if isSignedIn()
                    && isMatchParticipant(matchId)
                    && matchReadable(matchDoc(matchId))
                    && (resource.data.get('photoExpiresAt', null) == null
                        || resource.data.photoExpiresAt > request.time
                        || resource.data.senderId == request.auth.uid);
        allow create: if callerActive() && isSignedIn()
                      && isMatchParticipant(matchId)
                      && matchLive(matchDoc(matchId))
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.sentAt == request.time
                      && request.resource.data.get('status', 'sent') == 'sent'
                      && (validTextMessage(request.resource.data, matchDoc(matchId))
                          || validPhotoMessage(request.resource.data)
                          || validConsentMessage(request.resource.data)
                          || validContactCard(request.resource.data, matchDoc(matchId)));
        // Read receipts by the recipient; "delete for me" adds only yourself;
        // only the sender revokes a photo.
        allow update: if callerActive() && isSignedIn()
                      && isMatchParticipant(matchId)
                      && matchReadable(matchDoc(matchId))
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'deletedFor', 'viewedBy', 'viewedAt', 'photoRevoked'])
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'viewedBy', 'viewedAt'])
                          || resource.data.senderId != request.auth.uid)
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                          || request.resource.data.status == 'read')
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedFor'])
                          || request.resource.data.deletedFor.toSet().difference(resource.data.get('deletedFor', []).toSet())
                               .hasOnly([request.auth.uid]))
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoRevoked'])
                          || resource.data.senderId == request.auth.uid);
        allow delete: if false;
      }

      // Photo consent subcollection — per-match consent state for
      // self-destruct photo sharing. Participants-only.
      match /photoConsent/{doc} {
        allow read: if isSignedIn() && isMatchParticipant(matchId) && matchReadable(matchDoc(matchId));
        allow write: if callerActive() && isSignedIn() && isMatchParticipant(matchId) && matchLive(matchDoc(matchId));
      }

      // Typing indicators — matches/{matchId}/typing/{uid} exists while that
      // participant is typing. Participants read both; each writes only their own.
      match /typing/{typingUid} {
        allow read: if isSignedIn()
                    && isMatchParticipant(matchId)
                    && matchReadable(matchDoc(matchId));
        allow write: if callerActive() && isSignedIn()
                     && request.auth.uid == typingUid
                     && isMatchParticipant(matchId)
                     && matchLive(matchDoc(matchId));
      }
    }

    // ─── Play profiles (F-062) ─────────────────────────────────────────────
    // playProfiles/{playId}: the Play profile others see — no uid, nothing
    // from Spark but the age (functions/src/playProfiles.ts). Same rules the
    // Play profile had: the viewer and its owner both need Play access, the
    // owner mustn't be deleted, suspended or have blocked the viewer, and a
    // hidden profile is seen only by Play matches. Server-written.
    match /playProfiles/{playId} {
      allow read: if isSignedIn()
                  && (playId == myPlayId()
                      || (viewerHasPlay()
                          && hasPlay(playOwner(playId))
                          && profileVisible(playOwner(playId))
                          && notBlockedFrom(playOwner(playId))
                          && (resource == null || resource.data.get('playVisibility', 'active') != 'hidden' || playMatchedWith(playId))));
      allow write: if false;
    }

    // ─── Play matches (F-062) ──────────────────────────────────────────────
    // playMatches/{pm_…}: a Play match, its people named by Play ID only
    // (players; every per-person field). Who they are is server-only
    // (playMatchMembers). The same rules as matches, with Play IDs: the
    // caller's own is myPlayId(). Created only by Cloud Functions.
    match /playMatches/{matchId} {
      allow read: if isSignedIn()
                  && myPlayId() in resource.data.get('players', [])
                  && viewerHasPlay()
                  && playMatchReadable(resource.data);
      allow create, delete: if false;
      allow update: if callerActive() && isSignedIn()
                    && myPlayId() in resource.data.get('players', [])
                    && viewerHasPlay()
                    && matchLive(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'lastMessagePreview', 'lastMessageAt', 'lastSenderId', 'hasUnread',
                         'safetyCardShown', 'safetyCardShownAt', 'photoConsent',
                         'vibeCheckState_' + myPlayId()])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessagePreview'])
                        || request.resource.data.lastMessagePreview == null
                        || (request.resource.data.lastMessagePreview is string && request.resource.data.lastMessagePreview.size() <= 40))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
                        || request.resource.data.lastSenderId == myPlayId())
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoConsent'])
                        || request.resource.data.get('photoConsent', {}).get('status', '') != 'accepted'
                        || resource.data.get('photoConsent', {}).get('status', '') == 'accepted');

      // As under matches (see there); a curated partner is the server's isBot.
      function playValidFrank(d) {
        return !d.keys().hasAny(['fc', 'fk', 'fkn', 'cid', 'seq'])
            || (d.keys().hasAll(['fc', 'fk', 'fkn', 'cid', 'seq'])
                && d.fc is string && d.fc.matches('^[a-f0-9]{64}$')
                && d.fk is string && d.fk.size() <= 200
                && d.fkn is string && d.fkn.size() <= 64
                && d.cid is string && d.cid.matches('^[A-Za-z0-9_-]{8,64}$')
                && d.seq is int && d.seq >= 1 && d.seq <= 1000000);
      }
      function playValidText(d, m) {
        return d.keys().hasOnly(['ciphertext', 'nonce', 'senderId', 'sentAt', 'status', 'messageType', 'fh', 'fc', 'fk', 'fkn', 'cid', 'seq'])
            && playValidFrank(d)
            && d.messageType == 'text'
            && d.ciphertext is string && d.ciphertext.size() <= 20000
            && d.nonce is string && d.nonce != 'system' && d.nonce.size() <= 64
            && (!(d.nonce in ['stub', 'stub-nonce']) || m.get('isBot', false) == true)
            && (!('fh' in d) || (d.fh is string && d.fh.matches('^[a-f0-9]{64}$')));
      }
      function playValidPhoto(d) {
        return d.keys().hasOnly(['senderId', 'messageType', 'encrypted', 'storageRef', 'photoNonce',
                                 'encryptedKeyForSender', 'encryptedKeyForRecipient', 'keyNonceForSender',
                                 'keyNonceForRecipient', 'timerSeconds', 'firstViewedAt', 'photoExpiresAt',
                                 'destructedAt', 'sentAt', 'status', 'fc', 'fk', 'fkn', 'cid', 'seq'])
            && playValidFrank(d)
            && d.messageType == 'photo'
            && viewerHasSparkPlus()
            && playMatchDoc(matchId).get('photoConsent', {}).get('status', '') == 'accepted'
            && d.storageRef is string
            && d.storageRef.matches('^chat-photos/' + matchId + '/' + myPlayId() + '_[A-Za-z0-9._-]+$')
            && d.get('timerSeconds', 0) is int && d.get('timerSeconds', 0) >= 0 && d.get('timerSeconds', 0) <= 86400
            && d.get('firstViewedAt', null) == null && d.get('photoExpiresAt', null) == null && d.get('destructedAt', null) == null;
      }
      function playValidConsent(d) {
        return d.keys().hasOnly(['senderId', 'messageType', 'ciphertext', 'nonce', 'sentAt', 'status'])
            && d.messageType == 'consent_request'
            && d.nonce == 'system'
            && d.ciphertext in ['photo_consent_request', 'photo_consent_declined', 'photo_consent_paused'];
      }
      function playValidContactCard(d, m) {
        return d.keys().hasOnly(['ciphertext', 'nonce', 'senderId', 'sentAt', 'status', 'messageType'])
            && d.messageType == 'contact_card'
            && d.ciphertext is string && d.ciphertext.size() > 0 && d.ciphertext.size() <= 4000
            && d.nonce is string && d.nonce.size() <= 64 && !(d.nonce in ['stub', 'stub-nonce', 'system', 'revoked'])
            && m.get('isBot', false) != true
            && m.get('contactExchange', {}).get('status', '') == 'accepted'
            && (m.contactExchange.get('requestedBy', '') == myPlayId()
                || m.contactExchange.get('shareBack', false) == true);
      }
      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && isPlayParticipant(matchId)
                    && playMatchReadable(playMatchDoc(matchId))
                    && (resource.data.get('photoExpiresAt', null) == null
                        || resource.data.photoExpiresAt > request.time
                        || resource.data.senderId == myPlayId());
        allow create: if callerActive() && isSignedIn()
                      && isPlayParticipant(matchId)
                      && matchLive(playMatchDoc(matchId))
                      && request.resource.data.senderId == myPlayId()
                      && request.resource.data.sentAt == request.time
                      && request.resource.data.get('status', 'sent') == 'sent'
                      && (playValidText(request.resource.data, playMatchDoc(matchId))
                          || playValidPhoto(request.resource.data)
                          || playValidConsent(request.resource.data)
                          || playValidContactCard(request.resource.data, playMatchDoc(matchId)));
        allow update: if callerActive() && isSignedIn()
                      && isPlayParticipant(matchId)
                      && playMatchReadable(playMatchDoc(matchId))
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'deletedFor', 'viewedBy', 'viewedAt', 'photoRevoked'])
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'viewedBy', 'viewedAt'])
                          || resource.data.senderId != myPlayId())
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                          || request.resource.data.status == 'read')
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedFor'])
                          || request.resource.data.deletedFor.toSet().difference(resource.data.get('deletedFor', []).toSet())
                               .hasOnly([myPlayId()]))
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoRevoked'])
                          || resource.data.senderId == myPlayId());
        allow delete: if false;
      }
      match /photoConsent/{doc} {
        allow read: if isSignedIn() && isPlayParticipant(matchId) && playMatchReadable(playMatchDoc(matchId));
        allow write: if callerActive() && isSignedIn() && isPlayParticipant(matchId) && matchLive(playMatchDoc(matchId));
      }
      match /typing/{typingId} {
        allow read: if isSignedIn()
                    && isPlayParticipant(matchId)
                    && playMatchReadable(playMatchDoc(matchId));
        allow write: if callerActive() && isSignedIn()
                     && typingId == myPlayId()
                     && isPlayParticipant(matchId)
                     && matchLive(playMatchDoc(matchId));
      }
    }

    // ─── Swipes ─────────────────────────────────────────────────────────────
    // Users can create their own swipes, read none (server-side only)

    match /swipes/{swipeId} {
      // Write path moved to recordSwipe + sendSuperLike Callables.
      // Rule retained for legacy compat — suspension enforced server-side.
      allow create: if callerActive() && isSignedIn()
                    && request.resource.data.swiperId == request.auth.uid;
      allow read, update, delete: if false; // Cloud Functions only
    }

    // ─── Score Events ────────────────────────────────────────────────────────
    // Written by Cloud Functions and unmatch flow
    // Users can read their own score events only

    match /scoreEvents/{eventId} {
      allow read: if isSignedIn()
                  && resource.data.uid == request.auth.uid;
      // Write path moved to submitUnmatch Callable. Rule retained for
      // legacy compat — suspension enforced server-side.
      allow create: if callerActive() && isSignedIn()
                    && request.resource.data.reason.matches('unmatch_.*');
      allow update, delete: if false; // Cloud Functions only
    }

    // ─── Unmatch Reasons ────────────────────────────────────────────────────
    // Write only — no one reads these except admins via Cloud Functions

    match /unmatchReasons/{docId} {
      // Write path moved to submitUnmatch Callable. Rule retained for
      // legacy compat — suspension enforced server-side.
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ─── Banned phones ──────────────────────────────────────────────────────
    // Hashed phone numbers of reported users (reportAndBan /
    // onBeforeSignIn in zylove-web). Server only.
    match /bannedPhones/{phoneHash} {
      allow read, write: if false;
    }

    // ─── Review Queue ────────────────────────────────────────────────────────
    // Write only — safety team reads via admin SDK

    match /reviewQueue/{docId} {
      // Write path moved to submitUnmatch Callable. Rule retained for
      // legacy compat — suspension enforced server-side.
      allow create: if callerActive() && isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ─── Reports ────────────────────────────────────────────────────────────
    // Created ONLY by the reportUser Cloud Function (admin SDK bypass). The
    // rule here denies all client writes; admin SDK always bypasses rules.

    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Admin notifications (functions/src/adminAlerts.ts): an admin reads
    // their own settings (the Admin notifications screen); every write goes
    // through adminSetNotificationSettings (validated, audited). The
    // batching state and the event queue are server-only.
    match /adminNotificationSettings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && request.auth.token.admin == true;
      allow write: if false;
    }
    match /adminNotificationState/{uid} {
      allow read, write: if false;
    }
    match /adminAlertQueue/{id} {
      allow read, write: if false;
    }

    // ─── Reviews ────────────────────────────────────────────────────────────
    // Post-conversation reviews (Zylove Score input). CF-only writes; the
    // reviewee can read reviews written about them (needed for dispute flow
    // on the Zylove Score dashboard).

    match /reviews/{reviewId} {
      allow read: if isSignedIn() && resource.data.revieweeUid == request.auth.uid;
      allow write: if false;
    }

    // ─── Deletion Requests ──────────────────────────────────────────────────
    // Created ONLY by the requestAccountDeletion Callable. Admin SDK bypass.

    match /deletionRequests/{uid} {
      allow read, write: if false;
    }

    // ─── Popup Triggers ─────────────────────────────────────────────────────
    // Created by onCompatibilityPopup Cloud Function (admin SDK). Client
    // subscribes to its own trigger doc and marks it seen.

    match /popupTriggers/{uid} {
      allow read, update: if isUser(uid) && isSignedIn();
      allow create, delete: if false; // Admin SDK only
    }

    // ─── Deleted Accounts ───────────────────────────────────────────────────
    // Recovery records keyed by phone number. Only Cloud Functions (admin
    // SDK) read/write these during delete/restore flows.

    match /deletedAccounts/{phoneNumber} {
      allow read, write: if false;
    }

    // ─── Blocks (legacy top-level collection — prefer users/{uid}/blockedUsers) ─

    // Stage A: no client access — unblockMember trusted it for who blocked
    // whom. Blocks are users/{uid}/blockedUsers, written by Cloud Functions.
    match /blocks/{blockId} {
      allow read, write: if false;
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    // Users can read and update their own notifications only

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn()
                          && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn(); // Cloud Functions create these
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // ─── FCM Tokens ──────────────────────────────────────────────────────────

    match /fcmTokens/{uid} {
      allow read, write: if isUser(uid) && isSignedIn();
    }

    // ─── App Config (read-only for all signed-in users) ──────────────────────

    match /appConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only
    }

    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Public stats (landing page) ─────────────────────────────────────────
    // Non-sensitive numbers shown to signed-out visitors, e.g. the founding
    // circle counter (publicStats/founding). Written by Cloud Functions only.

    match /publicStats/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Public web forms (zylove-web /join and /contact) ────────────────────
    // Signed-out visitors may create entries only: fixed fields, size limits,
    // server timestamp. No client reads, edits or deletes; an existing
    // waitlist/application doc can't be overwritten.

    match /waitlist/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email == email && email.size() <= 254
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /foundingApplications/{email} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'instagram', 'why', 'createdAt'])
                    && request.resource.data.email == email
                    && request.resource.data.name is string && request.resource.data.name.size() <= 100
                    && request.resource.data.instagram.size() <= 100
                    && request.resource.data.why.size() <= 1000
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
                    && request.resource.data.name.size() <= 100 && request.resource.data.topic.size() <= 100
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ─── Deny everything else ────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
