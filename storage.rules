rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderSizeLimit() {
      // 10MB max per photo
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Set only by server-side copies (scripts/migrate-stage1b.mjs), which
    // onPhotoUpload doesn't moderate again — so clients may never set it.
    function sparkPlus() {
      let e = firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data.get('entitlement', {});
      return (e.get('until', null) == null || request.time < e.until)
          && (e.get('tier', 'free') == 'spark_plus' || e.get('tier', 'free') == 'elite');
    }

    // T&S Phase 4: the caller isn't suspended (same rule as firestore.rules
    // callerActive): no profile or chat photos from a suspended account, even
    // with a session that's still valid.
    function callerActive() {
      return !firestore.exists(/databases/(default)/documents/userInternal/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data.get('isSuspended', false) != true
          || firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data.get('suspendedForDeletion', false) == true
          || (firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data.get('suspendedUntil', null) != null
              && firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data.suspendedUntil <= request.time);
    }

    // F-096: not a deleted account (its sign-in can outlive the deletion by
    // up to an hour). Chat photos need no check: deletion ends every chat.
    function notDeleted() {
      return !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isDeleted', false) != true;
    }

    function noServerMetadata() {
      return request.resource.metadata == null
          || !('zyloveCopy' in request.resource.metadata);
    }

    // ─── Mobile-era paths (closed) ───────────────────────────────────────────
    // users/{uid}/photos, users/{uid}/verification and users/{uid}/consent
    // took unlimited 10 MB uploads that nothing moderated or used (F-091).
    // Nothing in the app or the functions writes them any more; whatever is
    // left there is the server's (scripts/lib/tokenSweep.mjs moves old
    // users/{uid}/photos files). The catch-all at the end denies them.

    // ─── Profile photos (top-level path used by app) ─────────────────────────
    // Path: photos/{uid}/{spark|play}/{filename}
    // The upload path of onboarding and the profile editors, watched by
    // onPhotoUpload (moderation). No client reads the files: everyone, owner
    // and admins included, sees a photo through a short-lived signed URL from
    // getPhotoUrls, which checks they may (F-021). (Read access would also
    // let a client mint a permanent download-token link with getDownloadURL.)
    // No updates: replacing a moderated photo's bytes would skip moderation.

    match /photos/{uid}/{mode}/{filename} {
      allow read:   if false;
      // resource == null: a new file only (Storage treats overwriting one as
      // a create).
      allow create: if isUser(uid) && isSignedIn() && isImage() && isUnderSizeLimit()
                    && callerActive()
                    && notDeleted()
                    // F-062: Play photos go under the Play ID (below), never the uid.
                    && mode == 'spark'
                    && resource == null
                    && noServerMetadata();
      allow update: if false;
      // Stage A: no client deletes. A deleted name could be uploaded again
      // with new bytes while Firestore still lists it as published; the
      // server deletes a photo once it's off every list (cleanupPhotoFiles).
      allow delete: if false;
    }

    // ─── Play profile photos (F-062) ─────────────────────────────────────────
    // Path: playPhotos/{playId}/{filename} — keyed by the uploader's Play ID
    // (server-only mapping, read here), so a Play photo's path never carries
    // the uid. Otherwise as photos/ above: onPhotoUpload moderates, signed
    // URLs only, no updates or client deletes.
    match /playPhotos/{playId}/{filename} {
      allow read: if false;
      allow create: if isSignedIn() && isImage() && isUnderSizeLimit()
                    && callerActive()
                    && notDeleted()
                    && firestore.get(/databases/(default)/documents/playIds/$(request.auth.uid)).data.playId == playId
                    && resource == null
                    && noServerMetadata();
      allow update, delete: if false;
    }

    // ─── Chat photos ─────────────────────────────────────────────────────────
    // Path: chat-photos/{matchId}/{filename}
    // Read/write gated on caller being a participant in the match doc.
    // firestore.get() validates membership server-side — adds one Firestore
    // read per access but eliminates matchId-enumeration risk.
    // F-091: as the Firestore rules for the chat itself (matchReadable /
    // matchLive): after a block only the blocker may still read them (their
    // evidence); new photos only while the match is live. A chat kept
    // read-only after an unmatch lists only who keeps it (users / players).

    // F-062: a Play match (pm_…) is playMatches/{id}, its people named by
    // Play ID (players); the sender's file is named for their Play ID.
    function myPlayId() {
      return firestore.get(/databases/(default)/documents/playIds/$(request.auth.uid)).data.playId;
    }
    function playMatch(matchId) {
      return firestore.get(/databases/(default)/documents/playMatches/$(matchId)).data;
    }
    function sparkMatch(matchId) {
      return firestore.get(/databases/(default)/documents/matches/$(matchId)).data;
    }
    // …with Play access, as the Firestore rules require for Play chats.
    function inPlayMatch(matchId) {
      let n = firestore.get(/databases/(default)/documents/userInternal/$(request.auth.uid)).data;
      return matchId.matches('^pm_[A-Za-z0-9]{20}$')
        && myPlayId() in playMatch(matchId).get('players', [])
        && n.get('playAccess', false) == true
        && (n.get('playAccessUntil', null) == null || request.time < n.playAccessUntil);
    }
    function inSparkMatch(matchId) {
      return sparkMatch(matchId).keys().hasAny(['users'])
        && request.auth.uid in sparkMatch(matchId).users;
    }
    // Firestore's matchReadable: not blocked, or blocked by the reader (a
    // Play match records the blocker's Play ID).
    function readable(m, me) {
      return m.get('isBlocked', false) != true || m.get('blockedBy', '') == me;
    }
    // Firestore's matchLive: not blocked, not unmatched.
    function live(m) {
      return m.get('isBlocked', false) != true && m.get('unmatchedAt', null) == null;
    }
    match /chat-photos/{matchId}/{filename} {
      allow read: if isSignedIn() && (
        (inPlayMatch(matchId) && readable(playMatch(matchId), myPlayId()))
        || (inSparkMatch(matchId) && readable(sparkMatch(matchId), request.auth.uid)));
      allow create: if isSignedIn()
        && callerActive()
        && sparkPlus()
        && request.resource.contentType == 'image/x-zylove-encrypted'
        && resource == null
        && isUnderSizeLimit()
        && inPlayMatch(matchId)
        && live(playMatch(matchId))
        && filename.matches(myPlayId() + '_[A-Za-z0-9._-]+')
        && playMatch(matchId).get('photoConsent', {}).get('status', '') == 'accepted';
      // A new file only, named for its sender (Stage A: the other participant
      // can't replace it); the app uploads ciphertext as image/x-zylove-encrypted.
      // Sending photos in chat is Spark+ (Stage C; userInternal entitlement,
      // a trial's tier ending at its `until`).
      allow create: if isSignedIn()
        && callerActive()
        && sparkPlus()
        && request.resource.contentType == 'image/x-zylove-encrypted'
        && resource == null
        && filename.matches(request.auth.uid + '_[A-Za-z0-9._-]+')
        && isUnderSizeLimit()
        && request.auth.uid in sparkMatch(matchId).users
        && live(sparkMatch(matchId))
        // T&S Phase 1: only once the other person accepted photo sharing.
        && sparkMatch(matchId).get('photoConsent', {}).get('status', '') == 'accepted';
      allow update: if false;
      allow delete: if false;
    }

    // ─── Profile review PDFs ─────────────────────────────────────────────────
    // Path: reviews/{uid}/{mode}/{reviewId}.pdf — generated server-side by
    // zylove-web's review functions. No client reads or writes: the owner
    // opens them through getReviewPdfUrl (short-lived signed URLs). Read
    // access would let a client mint a permanent token link (F-033).

    match /reviews/{uid}/{mode}/{filename} {
      allow read: if false;
      allow write: if false;
    }

    // ─── Deny everything else ─────────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
